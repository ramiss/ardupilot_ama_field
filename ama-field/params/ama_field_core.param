# AMA field mode - core settings (airframe independent)
#
# Load AFTER your airframe is calibrated, autotuned and flying well in FBWA.
# Mission Planner: Config > Full Parameter List > Load from file, then Write Params.
# These switch on the AMA field mode behaviour and set conservative starting
# values. Every line marked "FIELD" or "AIRFRAME" must be checked for your site
# and aircraft - see ama-field/docs/TUNING.md, section 2.
#
# --- enable AMA field mode (bit 1 land at roll start + bit 2 circuit away from pits) ---
AUTOLAND_OPTIONS,6
# FIELD: lowest height you accept on the circuit (obstacles + margin), metres
AUTOLAND_WP_ALT,20
# FIELD/AIRFRAME: length of the final, metres (~6-8 s at landing speed; 80-150 m typical)
AUTOLAND_WP_DIST,100
# FIELD: buffer between the runway centreline and the field mode's two circles, away from
# the pits, metres: the AUTOLAND base circle (the turn onto final ends this far out, so it
# can't overshoot toward the pits) and, + 10 m, the runway circle for TAKEOFF, RTL and the
# fence return. Other loiters (LOITER mode, mission/GUIDED loiters) aren't affected
AUTOLAND_SIDEGAP,5
# FIELD/AIRFRAME: start the even circle descent this many degrees before lined up on final:
# 180 = as the turn from downwind begins (the base circle must be clear down to
# AUTOLAND_FNL_HGT; 0 = level until lined up)
AUTOLAND_DSC_ARC,180
# FIELD/AIRFRAME: height at the start of the final, reached 60 degrees before lined up and held
# level to the final; the final glides from it to the touchdown aim (8 m over 100 m is ~4.6 deg)
AUTOLAND_FNL_HGT,8
# AIRFRAME: rollout steering multiplier; start at 1, raise if it swings off as it slows
AUTOLAND_RO_GAIN,1
# AIRFRAME: touchdown aim short of the roll start, for the float after the flare. Each
# landing reports where it touched down and suggests a value ("Autoland: suggest AUTOLAND_TD_OFS 29
# (now 25)"): set it by hand from a few landings
AUTOLAND_TD_OFS,25
AUTOLAND_DIR_OFF,0
AUTOLAND_CLIMB,0
#
# --- no baro compensation: vent a pressurised fuselage instead (TUNING.md section 4) ---
# (only some boards have these two; where they are missing the loader just skips them)
BARO1_THST_SCALE,0
BARO1_WCF_ENABLE,0
#
# --- runway circle is the RTL point; no rally points ---
RTL_AUTOLAND,0
RALLY_TOTAL,0
#
# --- fence: bounce back from FBWB/FBWA/CRUISE, return to the runway circle ---
FENCE_ENABLE,1
# circle + maximum altitude
FENCE_TYPE,3
# 6 = Guided (required for the bounce-back)
FENCE_ACTION,6
# required: 0 = return to the runway circle, not a rally point
FENCE_RET_RALLY,0
# FIELD: radius around HOME and ceiling, metres - keep the whole circuit inside with margin
FENCE_RADIUS,300
FENCE_ALT_MAX,120
#
# --- FBWB as the everyday mode: altitude hold with a floor ---
# FIELD: FBWB/CRUISE won't descend below this (land with AUTOLAND, FBWA or MANUAL)
CRUISE_ALT_FLOOR,20
#
# --- landing basics (refine per airframe, TUNING.md section 7) ---
LAND_FLARE_SEC,2
LAND_FLARE_ALT,2
LAND_DISARMDELAY,20
TECS_LAND_SINK,0.5
# limit nose-down pitch in the automatic modes: no part of the approach can become a dive
TECS_PITCH_MIN,-12
#
# --- rangefinder (optional). Leave as is with no rangefinder fitted. ---
# With a downward rangefinder fitted and configured, set RNGFND_LANDING 1.
RNGFND_LANDING,0
