# EXAMPLE ONLY - Freewing Pandora (1.2 m foam high-wing taildragger, 3S, no airspeed
# sensor, fuselage vented with a hole) with a MicoAir MT-06 rangefinder and an ESP32
# MAVLink logger. These are the values that worked on that one test aircraft at that
# one field (2026-11-22).
# They are a worked example of an AMA field mode setup, not defaults for your plane:
# start from ../ama_field_core.param and see ama-field/docs/TUNING.md.
# Contains no calibration values.
#
# --- custom runway-circuit features (AUTOLAND_OPTIONS bits 1+2) ---
AUTOLAND_OPTIONS,6
AUTOLAND_WP_ALT,20
AUTOLAND_WP_DIST,85
AUTOLAND_SIDEGAP,5
# even ~1.8 m/s descent round the base circle from the start of the half turn off
# downwind (180 deg before lined up; trees under the downwind leg), level for the last
# 60 deg at 8 m, then a 1.5 m/s final (v16/v17: DSC_ARC 90 started the final ~5 m high
# and dived at 4.5 m/s)
AUTOLAND_DSC_ARC,180
AUTOLAND_FNL_HGT,8
AUTOLAND_RO_GAIN,3
# vented, with v16's diving final: touched down a few metres before the roll start.
# The gentle final floats less (SITL: ~20 m shorter): check the touchdown reports
AUTOLAND_TD_OFS,25
AUTOLAND_DIR_OFF,0
AUTOLAND_CLIMB,0
#
# --- no baro compensation: the fuselage is vented instead ---
# (v17's compensation, 50 Pa thrust scale learned on takeoff + WCF_FWD 0.15, read
# 3-4 m high on the approach and caused a crash). Set these to 0 while still on v17, before flashing.
BARO1_THST_SCALE,0
BARO1_WCF_ENABLE,0
#
# --- takeoff (taildragger: tail held down with up elevator) ---
TKOFF_ALT,50
TKOFF_DIST,120
TKOFF_LVL_ALT,10
TKOFF_LVL_PITCH,15
TKOFF_GND_PITCH,11
TKOFF_ROTATE_SPD,10
TKOFF_TDRAG_ELEV,60
TKOFF_TDRAG_SPD1,9
TKOFF_THR_SLEW,20
GROUND_STEER_ALT,5
STEER2SRV_P,6
STEER2SRV_I,0
STEER2SRV_IMAX,800
STEER2SRV_MINSPD,3
STEER2SRV_TCONST,0.5
LEVEL_ROLL_LIMIT,10
#
# --- navigation ---
NAVL1_PERIOD,13
NAVL1_DAMPING,0.85
WP_LOITER_RAD,30
RTL_ALTITUDE,60
RTL_AUTOLAND,0
RALLY_TOTAL,0
#
# --- landing ---
LAND_FLARE_ALT,2
LAND_FLARE_SEC,2
LAND_PITCH_DEG,8
LAND_PF_ALT,6
LAND_DISARMDELAY,20
TECS_LAND_SINK,0.6
TECS_LAND_ARSPD,15
TECS_LAND_PMAX,10
TECS_SINK_MAX,5
# no nose-down pitch beyond 12 deg in the automatic modes (about 3.3 m/s at 16 m/s)
TECS_PITCH_MIN,-12
RNGFND_LANDING,1
#
# --- speed / height control ---
AIRSPEED_CRUISE,14
AIRSPEED_MIN,10
AIRSPEED_MAX,22
TRIM_THROTTLE,50
TECS_PITCH_MAX,20
FBWB_CLIMB_RATE,5
CRUISE_ALT_FLOOR,20
AHRS_WIND_MAX,7
# 1090 = 1024 (mid throttle = TRIM_THROTTLE) + 64 (no gain boost at low speed in auto takeoff) + 2 (mid throttle = cruise airspeed in CRUISE/FBWB)
FLIGHT_OPTIONS,1090
#
# --- fence (bounce-back needs FENCE_ACTION 6 and FENCE_RET_RALLY 0) ---
FENCE_ENABLE,1
FENCE_TYPE,3
FENCE_ACTION,6
FENCE_RADIUS,240
FENCE_ALT_MAX,100
FENCE_OPTIONS,0
FENCE_RET_RALLY,0
#
# --- MicoAir MT-06 rangefinder (I2C, IIC_NOOPLOOP mode, ID 0) ---
RNGFND1_TYPE,40
RNGFND1_ADDR,8
RNGFND1_ORIENT,25
RNGFND1_MIN,0.05
RNGFND1_MAX,6
RNGFND1_GNDCLR,0.11
#
# --- ALTERNATIVE: Benewake TF-Luna instead of the MT-06 (I2C: pin 5 to ground) ---
# Not flown yet. To use it, comment out the MT-06 block above and uncomment these.
# Check the boot message "TFMiniPlus: found fw version ..." (type 25 may not detect
# a TF-Luna: see TUNING.md 2.4). 0.2 m minimum range: on this aircraft it can't see
# the ground on its wheels, so touchdown uses blind-zone detection. Measure the
# outdoor range on the first flight (low passes at 2, 4, 6, 8 m; RFSS in the log).
#RNGFND1_TYPE,25
#RNGFND1_ADDR,16
#RNGFND1_ORIENT,25
#RNGFND1_MIN,0.2
#RNGFND1_MAX,8
# measured: what it reads on the wheels; below RNGFND1_MIN it reads nothing there,
# then set the lens height above the ground
#RNGFND1_GNDCLR,0.11
#RNGFND_LANDING,1
#
# --- MAVLink logging to the ESP32 logger on SERIAL3 (DJI port) ---
# set LOG_BACKEND_TYPE 0 (and reboot) to turn logging off
LOG_BACKEND_TYPE,2
LOG_BITMASK,27446
LOG_MAV_RATEMAX,10
LOG_DISARMED,0
EK3_LOG_LEVEL,1
SERIAL3_PROTOCOL,2
SERIAL3_BAUD,115
ARMING_SKIPCHK,1024
